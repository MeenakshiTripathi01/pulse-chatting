# Copy this file to server/.env and fill in real values. Never commit server/.env.

NODE_ENV=development
PORT=5000

# MongoDB connection string.
# Atlas example: mongodb+srv://<username>:<password>@<cluster-host>/realtime-chat?retryWrites=true&w=majority
# Local example: mongodb://127.0.0.1:27017/realtime-chat
MONGODB_URI=

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# How long a login lasts, in seconds (default: 7 days).
JWT_EXPIRES_IN_SECONDS=604800

# Browser origin(s) allowed to call the API and open sockets (comma-separated, no trailing slash).
# Development with the Vite dev server: http://localhost:5173
# Production: your public app URL, e.g. https://chat.example.com
CLIENT_ORIGIN=http://localhost:5173

# lax (same-site deployments, recommended) | strict | none (frontend and API on different sites; production only)
COOKIE_SAME_SITE=lax

# Number of reverse proxies in front of the server (set to 1 on Render, Railway, Heroku, etc.).
TRUST_PROXY=0

# true = Express also serves the built React app (client/dist) for single-service deployments.
SERVE_CLIENT=false

# Login/registration attempts allowed per IP per 15 minutes.
AUTH_RATE_LIMIT_MAX=20
