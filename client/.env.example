# Optional. Leave unset for the default setups:
#  - development: the Vite dev server proxies /api and /socket.io to http://localhost:5000
#  - production (single service): Express serves this app and the API from the same origin
#
# Only set this if the API is deployed on a DIFFERENT origin than the frontend.
# VITE_* values are bundled into public JavaScript: never put secrets here.
# VITE_API_URL=https://api.example.com/api

# Optional: where the Vite dev proxy forwards API traffic (default http://localhost:5000).
# VITE_DEV_API_TARGET=http://localhost:5000
